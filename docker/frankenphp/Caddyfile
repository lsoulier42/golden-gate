{
	# Options globales FrankenPHP.
	# Prod (itération suivante) : définir FRANKENPHP_CONFIG="worker /var/www/html/public/index.php" ;
	# en dev la variable est vide → mode classic (comportement PHP-FPM).
	frankenphp {
		{$FRANKENPHP_CONFIG}
	}

	# HTTP simple : le port publié est géré par Docker, pas d'HTTPS automatique ici.
	auto_https off
}

:8080 {
	root * /var/www/html/public
	encode zstd br gzip

	# Borne la taille des corps de requête acceptés, en miroir de
	# GatewayRequestBodyListener (1 Mo), pour que le gateway se comporte de la même
	# façon quel que soit le serveur qui le précède.
	request_body {
		max_size 1MB
	}

	# API Symfony / API Platform (+ Swagger UI /api/docs), et API publique du
	# gateway LLM (/v1/chat/completions, /v1/models) qui parle aux applications
	# clientes et non au navigateur.
	@backend path /api /api/* /v1 /v1/*
	handle @backend {
		php_server
	}

	# SPA React buildée (make frontend-build) : assets puis fallback index.html.
	handle {
		root * /var/www/html/frontend/dist
		try_files {path} /index.html
		file_server
	}
}
