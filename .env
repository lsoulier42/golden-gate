###> golden-gate/gateway ###
# Upstream providers. Leave the API keys empty here: real values belong to
# .env.local (gitignored), .env.<env>.local or Symfony secrets.
OVHCLOUD_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net
OVHCLOUD_API_KEY=
MISTRAL_BASE_URL=https://api.mistral.ai
MISTRAL_API_KEY=
# Requests per minute allowed for one API key (burst protection).
GATEWAY_RATE_LIMIT_PER_MINUTE=60
###< golden-gate/gateway ###

